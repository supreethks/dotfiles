# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Ghostty – Daily Driver Config                                      ║
# ║  Theme: Kanagawa Wave (matches tmux)  ·  Font: JetBrainsMono NF    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Theme ────────────────────────────────────────────────────────────────
# Pastel Dark theme (matches iTerm2)
theme = "iTerm2 Pastel Dark Background"

# ── Font ─────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14.0
font-thicken = true
adjust-cell-height = 15%

# ── Window & Appearance ─────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend

# Opaque pitch-black background (no translucency)
background = #000000
background-opacity = 1
background-blur = false
unfocused-split-opacity = 1

# macOS native feel
macos-titlebar-style = tabs
macos-option-as-alt = true
window-save-state = never
window-theme = auto
confirm-close-surface = false

# Cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Shell Integration ────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Clipboard ────────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false

# ── Quick Terminal (quake-style drop-down → Herdr quake session) ───────
# zsh/.zshrc auto-starts herdr --session quake when GHOSTTY_QUICK_TERMINAL=1.
command =
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 75%
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# ── Keybindings ──────────────────────────────────────────────────────────
# Herdr uses Ctrl+Space as prefix. Ghostty cannot pass raw Cmd chords through
# to a TUI, so Cmd shortcuts are forwarded as text:\x00<key> sequences.
# macOS: run ~/dotfiles/scripts/macos-disable-ghostty-hide.sh so Cmd+H works.

# Cmd+E → AIChat shell helper (Aerospace owns Option+E as workspace E).
keybind = cmd+e=esc:e

# Herdr tab/workspace nav (Cmd+Arrow keys)
keybind = super+arrow_left=text:\x00h
keybind = super+arrow_right=text:\x00l
keybind = super+arrow_up=text:\x00u
keybind = super+arrow_down=text:\x00d

# Herdr pane focus (Cmd+Shift+Arrow → prefix+Shift+HJKL)
keybind = super+shift+arrow_left=text:\x00H
keybind = super+shift+arrow_right=text:\x00L
keybind = super+shift+arrow_up=text:\x00K
keybind = super+shift+arrow_down=text:\x00J

# Herdr splits (Cmd+D / Cmd+Shift+D)
keybind = super+d=text:\x00v
keybind = super+shift+d=text:\x00-

# Herdr resize (Cmd+Option+HJKL → prefix+Ctrl+HJKL)
keybind = super+alt+h=text:\x00\x08
keybind = super+alt+j=text:\x00\x0a
keybind = super+alt+k=text:\x00\x0b
keybind = super+alt+l=text:\x00\x0c

# Herdr zoom, tabs, close
keybind = super+shift+enter=text:\x00z
keybind = super+t=text:\x00c
keybind = super+w=text:\x00x

# Herdr tab switch (Cmd+1..9)
keybind = super+digit_1=text:\x001
keybind = super+digit_2=text:\x002
keybind = super+digit_3=text:\x003
keybind = super+digit_4=text:\x004
keybind = super+digit_5=text:\x005
keybind = super+digit_6=text:\x006
keybind = super+digit_7=text:\x007
keybind = super+digit_8=text:\x008
keybind = super+digit_9=text:\x009

# Ghostty host actions (scroll, prompt jump, reload)
keybind = cmd+shift+r=reload_config
keybind = cmd+u=scroll_page_up
keybind = cmd+shift+u=scroll_page_down
keybind = cmd+g=jump_to_prompt:-1
keybind = cmd+shift+g=jump_to_prompt:1

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Native macOS copy/paste
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
