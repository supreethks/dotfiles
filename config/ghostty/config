# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Ghostty – Daily Driver Config                                      ║
# ║  Theme: Kanagawa Wave (matches tmux)  ·  Font: JetBrainsMono NF    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Theme ────────────────────────────────────────────────────────────────
# Tokyo Night dark theme
theme = "TokyoNight"

# ── Font ─────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14.0
font-thicken = true
adjust-cell-height = 15%

# ── Window & Appearance ─────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend

# Translucent background with blur (macOS)
background-opacity = 0.90
background-blur-radius = 30
unfocused-split-opacity = 0.85

# macOS native feel
macos-titlebar-style = tabs
macos-option-as-alt = true
window-save-state = always
window-theme = auto
confirm-close-surface = false

# Cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Shell Integration ────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Clipboard ────────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# ── Quick Terminal (global drop-down) ────────────────────────────────────
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# ── Keybindings ──────────────────────────────────────────────────────────
# Splits (Cmd+D / Cmd+Shift+D like iTerm)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Navigate splits with Cmd+Option+Arrows
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

# Resize splits
keybind = cmd+ctrl+left=resize_split:left,20
keybind = cmd+ctrl+right=resize_split:right,20
keybind = cmd+ctrl+up=resize_split:up,20
keybind = cmd+ctrl+down=resize_split:down,20

# Equalize splits
keybind = cmd+shift+equal=equalize_splits

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# ── Start tmux automatically ────────────────────────────────────────────
command = /bin/zsh -lc ~/.config/ghostty/tmux_ghostty.sh
