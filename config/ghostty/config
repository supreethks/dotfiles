# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Ghostty – Daily Driver Config                                      ║
# ║  Theme: Catppuccin Mocha  ·  Font: JetBrainsMono NF               ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Theme ────────────────────────────────────────────────────────────────
theme = "Catppuccin Mocha"

# ── Font ─────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-size = 14.0
font-feature = +calt,+liga
font-thicken = true
adjust-cell-height = 15%

# ── Window & Appearance ─────────────────────────────────────────────────
window-decoration = false
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
window-step-resize = true

# Translucent background with blur (macOS)
background-opacity = 0.90
background-blur-radius = 30
unfocused-split-opacity = 0.70

# macOS native feel
macos-titlebar-style = hidden
macos-option-as-alt = left
window-save-state = never
window-theme = auto
confirm-close-surface = false

# Cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Shell Integration ────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Clipboard ────────────────────────────────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false

# ── Quick Terminal (quake-style drop-down → Herdr quake session) ───────
# zsh/.zshrc auto-starts herdr --session quake when GHOSTTY_QUICK_TERMINAL=1.
command =
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 75%
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# ── Keybindings ──────────────────────────────────────────────────────────
# Pane/tab/split navigation is handled by Herdr (see config/herdr/config.toml).
# macOS: disable Ghostty "Hide" on Cmd+H in System Settings → Keyboard →
# App Shortcuts so Herdr can use Cmd+H for pane-left focus.

# Cmd+E → AIChat shell helper (Aerospace owns Option+E as workspace E).
keybind = cmd+e=esc:e

# Ghostty host actions (scroll, prompt jump, reload)
keybind = cmd+shift+r=reload_config
keybind = cmd+u=scroll_page_up
keybind = cmd+shift+u=scroll_page_down
keybind = cmd+g=jump_to_prompt:-1
keybind = cmd+shift+g=jump_to_prompt:1

# Font size
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Native macOS copy/paste
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
